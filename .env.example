# ── Payments (Razorpay) ─────────────────────────────────────────────────────────
# Keys from https://dashboard.razorpay.com/app/keys. Use rzp_test_… keys while developing (no real money).
# Leave both empty to run checkout in demo mode (nothing is charged; plans unlock for free).
# The secret is read only by the API server; it must never be exposed to the browser.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret (Razorpay → Webhooks; events payment.authorized, payment.captured, order.paid; URL /api/payments/webhook).
# Applies payments whose browser never returned, e.g. a UPI QR approved after the checkout tab closed. Set it before going live.
RAZORPAY_WEBHOOK_SECRET=""

# ── Storage for published invitations and RSVPs ─────────────────────────────────
# Postgres connection string (e.g. a free Neon database). Leave empty to use a JSON file in DATA_DIR.
DATABASE_URL=""
# Folder for the JSON file store when DATABASE_URL is empty. Must be on a persistent disk in production.
DATA_DIR="./data"

# ── Business details ────────────────────────────────────────────────────────────
# Brand name, contact details, GSTIN, prices and plan limits are NOT set here: edit site.config.ts.
# This file is only for secrets and server settings.

# Port for the API server (and the built app in production). Vite proxies /api here in dev.
PORT=3001

# ── Email invitations (optional; paid plans) ────────────────────────────────────
# Resend (resend.com, free tier 3,000 emails/month). Verify your sending domain there first.
# Leave empty and couples send by WhatsApp only.
RESEND_API_KEY=""
EMAIL_FROM="WeddingVerse <invites@yourdomain.in>"
# Also sends the 6-digit sign-in codes for couples' accounts (#/account). Without it, sign-in is off.
# AUTH_DEV_CODES=1 returns the code in the API response when no email provider is set: tests only, never in production.
AUTH_DEV_CODES=""

# ── Owner dashboard (#/admin) ───────────────────────────────────────────────────
# A long random secret (16+ characters). Leave empty to turn the dashboard off.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=""
# ── Keep-awake (free hosts that sleep when idle) ────────────────────────────────
# On Render the server pings RENDER_EXTERNAL_URL/api/health every 4 min automatically.
# On other hosts set your public URL here. KEEP_AWAKE=0 turns it off.
KEEP_AWAKE_URL=""
KEEP_AWAKE=""
